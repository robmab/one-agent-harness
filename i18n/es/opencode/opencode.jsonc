{
  "$schema": "https://opencode.ai/config.json",

  // FILL-IN: modelo por defecto. Con un modelo local: "local/<id del modelo>" (el proveedor de abajo).
  // Con uno en la nube, borra "model" y "providers" y conéctalo con /connect.
  "model": "local/FILL-IN",

  // FILL-IN: servidor local compatible con OpenAI (llama.cpp, LM Studio, Ollama…). Un modelo por perfil del servidor.
  "providers": {
    "local": {
      "name": "local",
      "package": "@opencode/ai/providers/openai-compatible",
      "settings": {
        "baseURL": "http://localhost:8080/v1",
        "apiKey": "FILL-IN",
        // En local el primer token tarda con prompts largos: sin timeouts
        "chunkTimeout": false,
        "headerTimeout": false
      },
      "models": {
        "FILL-IN": {
          "modelID": "FILL-IN",
          "name": "FILL-IN",
          // input: ["text", "image"] solo si el servidor carga la visión del modelo
          "capabilities": { "tools": true, "input": ["text"], "output": ["text"] },
          // El contexto real del servidor (ctx-size), no el máximo del modelo
          "limit": { "context": 131072, "output": 16384 },
          // llama.cpp manda el razonamiento en este campo
          "compatibility": { "reasoningField": "reasoning_content" }
        }
      }
    }
  },

  // FILL-IN: skills que el equipo tenga en el repo (p. ej. "<ruta del repo>/.github/skills"); las del harness entran por junction
  "skills": [],

  "agents": {
    // Con un servidor local de un solo slot, la petición del título echa la caché del turno principal: fuera. Con un proveedor en la nube, borra esta línea o las sesiones se quedan con un título genérico
    "title": { "disabled": true },
    // El revisor (agents/reviewer.md, generado por sync.py): sin editar y con tope de pasos.
    // "all": como subagente desde otra sesión y también directo (opencode run --agent reviewer, scripts)
    "reviewer": {
      // Opcional: otro modelo para el revisor (ver la nota al principio de agents/reviewer.md)
      // "model": "proveedor/modelo",
      "mode": "all",
      "steps": 60,
      "permissions": [{ "action": "edit", "resource": "*", "effect": "deny" }]
    }
  },

  // Búsqueda web gratis con DuckDuckGo (necesita uv: winget install astral-sh.uv). Sin codemode: con modelos
  // locales, mejor sus 2 herramientas a la vista. Si no lo quieres, borra el bloque y sus reglas de permisos
  "mcp": {
    "servers": {
      // Opcional: tu Chrome, con tus sesiones (el gestor de incidencias, la app), si el router lo pide.
      // Activa chrome://inspect/#remote-debugging; al descomentarlo, descomenta también sus permisos de abajo
      // "chrome-devtools": { "type": "local", "command": ["npx", "-y", "chrome-devtools-mcp@1.11.0", "--autoConnect"], "codemode": false },
      "ddg-search": { "type": "local", "command": ["uvx", "duckduckgo-mcp-server"], "codemode": false }
    }
  },

  // Nada de compartir sesiones; la búsqueda web integrada necesita clave de pago (y apagada sale del prompt)
  "share": "disabled",
  "websearch": false,

  // Compacta con margen y deja sitio para trabajar (ajústalo a tu contexto)
  "compaction": { "auto": true, "buffer": 16384, "keep": { "tokens": 12000 } },

  // Gana la última regla que encaje: lo general arriba, las excepciones abajo
  "permissions": [
    { "action": "shell", "resource": "*", "effect": "ask" },
    { "action": "shell", "resource": "git status *", "effect": "allow" },
    { "action": "shell", "resource": "git diff *", "effect": "allow" },
    { "action": "shell", "resource": "git log *", "effect": "allow" },
    { "action": "shell", "resource": "git show *", "effect": "allow" },
    { "action": "shell", "resource": "git grep *", "effect": "allow" },
    { "action": "shell", "resource": "py -3 <HARNESS>/personal/scripts/check.py *", "effect": "allow" },
    // Solo lee los logs de las sesiones, para el repaso
    { "action": "shell", "resource": "py -3 <HARNESS>/personal/scripts/read_session.py *", "effect": "allow" },
    { "action": "shell", "resource": "git push *", "effect": "deny" },
    { "action": "shell", "resource": "git reset --hard *", "effect": "deny" },
    { "action": "shell", "resource": "rm -rf *", "effect": "deny" },
    // El harness (convenios, skills, sensor) se puede leer sin preguntar
    { "action": "external_directory", "resource": "<HARNESS>/*", "effect": "allow" },
    { "action": "read", "resource": "<HARNESS>/*", "effect": "allow" },
    { "action": "edit", "resource": "<HARNESS>/*", "effect": "ask" },
    // Cada ruta de FORBIDDEN_PATHS de guard.py, como deny (el plugin guard.ts solo ve órdenes), p. ej.:
    // { "action": "edit", "resource": "<REPO>/docs/equipo/*", "effect": "deny" },
    // Red: buscar sí (títulos y fragmentos); leer páginas enteras, con tu permiso: una web puede esconder
    // instrucciones para el modelo. FILL-IN: la documentación oficial de tu stack, sin preguntar, p. ej.:
    // { "action": "webfetch", "resource": "https://docs.python.org/3.12/*", "effect": "allow" },
    { "action": "webfetch", "resource": "*", "effect": "ask" },
    { "action": "ddg-search_search", "resource": "*", "effect": "allow" },
    { "action": "ddg-search_fetch_content", "resource": "*", "effect": "ask" },
    // Con chrome-devtools: leer pestañas y páginas sin preguntar
    // { "action": "chrome-devtools_list_pages", "resource": "*", "effect": "allow" },
    // { "action": "chrome-devtools_select_page", "resource": "*", "effect": "allow" },
    // { "action": "chrome-devtools_evaluate_script", "resource": "*", "effect": "allow" },
    // { "action": "chrome-devtools_take_screenshot", "resource": "*", "effect": "allow" },
    // { "action": "chrome-devtools_list_console_messages", "resource": "*", "effect": "allow" },
    // { "action": "chrome-devtools_list_network_requests", "resource": "*", "effect": "allow" },

    // Solo las skills del harness: OpenCode sube desde el proyecto hasta el home buscando .claude/skills y .agents/skills,
    // y si el repo cuelga de tu home se trae las de otras herramientas. Cada skill nueva, aquí (la CI lo comprueba)
    { "action": "skill", "resource": "*", "effect": "deny" },
    { "action": "skill", "resource": "conventions", "effect": "allow" },
    { "action": "skill", "resource": "ui", "effect": "allow" },
    { "action": "skill", "resource": "stack", "effect": "allow" },
    { "action": "skill", "resource": "prepare", "effect": "allow" },
    { "action": "skill", "resource": "diagnose", "effect": "allow" },
    { "action": "skill", "resource": "verify", "effect": "allow" },
    { "action": "skill", "resource": "voice", "effect": "allow" },
    { "action": "skill", "resource": "retro", "effect": "allow" }
  ]
}
