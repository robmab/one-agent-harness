{
  "$schema": "https://opencode.ai/config.json",

  // FILL-IN: default model. With a local model: "local/<model id>" (the provider below).
  // With a cloud one, delete "model" and "providers" and connect it with /connect.
  "model": "local/FILL-IN",

  // FILL-IN: local OpenAI-compatible server (llama.cpp, LM Studio, Ollama…). One model per server profile.
  "providers": {
    "local": {
      "name": "local",
      "package": "@opencode/ai/providers/openai-compatible",
      "settings": {
        "baseURL": "http://localhost:8080/v1",
        "apiKey": "FILL-IN",
        // Locally the first token takes a while with long prompts: no timeouts
        "chunkTimeout": false,
        "headerTimeout": false
      },
      "models": {
        "FILL-IN": {
          "modelID": "FILL-IN",
          "name": "FILL-IN",
          // input: ["text", "image"] only if the server loads the model's vision
          "capabilities": { "tools": true, "input": ["text"], "output": ["text"] },
          // The server's real context (ctx-size), not the model's maximum
          "limit": { "context": 131072, "output": 16384 },
          // llama.cpp sends the reasoning in this field
          "compatibility": { "reasoningField": "reasoning_content" }
        }
      }
    }
  },

  // FILL-IN: skills the team keeps in the repo (e.g. "<repo path>/.github/skills"); the harness ones come in through the junction
  "skills": [],

  "agents": {
    // With a single-slot local server, the title request evicts the main turn's cache: off
    "title": { "disabled": true },
    // The reviewer (agents/reviewer.md, generated by sync.py): no edits and a step limit.
    // "all": as a subagent from another session and also directly (opencode run --agent reviewer, scripts)
    "reviewer": {
      // Optional: another model for the reviewer (see the note at the top of agents/reviewer.md)
      // "model": "provider/model",
      "mode": "all",
      "steps": 40,
      "permissions": [{ "action": "edit", "resource": "*", "effect": "deny" }]
    }
  },

  // Free web search with DuckDuckGo (needs uv: winget install astral-sh.uv). No codemode: with local
  // models, better to have its 2 tools in plain sight. If you don't want it, delete the block and its permission rules
  "mcp": {
    "servers": {
      "ddg-search": { "type": "local", "command": ["uvx", "duckduckgo-mcp-server"], "codemode": false }
    }
  },

  // No session sharing; the built-in web search needs a paid key (and when off it leaves the prompt)
  "share": "disabled",
  "websearch": false,

  // Compact with margin and leave room to work (adjust it to your context)
  "compaction": { "auto": true, "buffer": 16384, "keep": { "tokens": 12000 } },

  // The last matching rule wins: general rules on top, exceptions below
  "permissions": [
    { "action": "shell", "resource": "*", "effect": "ask" },
    { "action": "shell", "resource": "git status *", "effect": "allow" },
    { "action": "shell", "resource": "git diff *", "effect": "allow" },
    { "action": "shell", "resource": "git log *", "effect": "allow" },
    { "action": "shell", "resource": "git show *", "effect": "allow" },
    { "action": "shell", "resource": "git grep *", "effect": "allow" },
    { "action": "shell", "resource": "py -3 <HARNESS>/personal/scripts/check.py *", "effect": "allow" },
    { "action": "shell", "resource": "git push *", "effect": "deny" },
    { "action": "shell", "resource": "git reset --hard *", "effect": "deny" },
    { "action": "shell", "resource": "rm -rf *", "effect": "deny" },
    // The harness (conventions, skills, sensor) can be read without asking
    { "action": "external_directory", "resource": "<HARNESS>/*", "effect": "allow" },
    { "action": "read", "resource": "<HARNESS>/*", "effect": "allow" },
    { "action": "edit", "resource": "<HARNESS>/*", "effect": "ask" },
    // Network: searching yes (titles and snippets); reading whole pages, with your permission: a page can hide
    // instructions for the model. FILL-IN: your stack's official docs, without asking, e.g.:
    // { "action": "webfetch", "resource": "https://docs.python.org/3.12/*", "effect": "allow" },
    { "action": "webfetch", "resource": "*", "effect": "ask" },
    { "action": "ddg-search_search", "resource": "*", "effect": "allow" },
    { "action": "ddg-search_fetch_content", "resource": "*", "effect": "ask" },

    // Only the harness skills: OpenCode walks up from the project to your home looking for .claude/skills and .agents/skills,
    // and if the repo lives under your home it picks up other tools' skills. Every new skill goes here (CI checks it)
    { "action": "skill", "resource": "*", "effect": "deny" },
    { "action": "skill", "resource": "conventions", "effect": "allow" },
    { "action": "skill", "resource": "ui", "effect": "allow" },
    { "action": "skill", "resource": "stack", "effect": "allow" },
    { "action": "skill", "resource": "prepare", "effect": "allow" },
    { "action": "skill", "resource": "diagnose", "effect": "allow" },
    { "action": "skill", "resource": "verify", "effect": "allow" },
    { "action": "skill", "resource": "voice", "effect": "allow" },
    { "action": "skill", "resource": "retro", "effect": "allow" }
  ]
}
