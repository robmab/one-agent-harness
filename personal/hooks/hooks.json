{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell|Write|Edit|MultiEdit|Agent|Task|AskUserQuestion",
        "hooks": [
          { "type": "command", "command": "py -3 \"${CLAUDE_PLUGIN_ROOT}/scripts/guard.py\" --hook" }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          { "type": "command", "command": "py -3 \"${CLAUDE_PLUGIN_ROOT}/scripts/check.py\" --hook" }
        ]
      }
    ]
  }
}
